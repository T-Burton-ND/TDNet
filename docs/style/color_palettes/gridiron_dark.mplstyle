figure.facecolor       : 11214F
figure.edgecolor       : 11214F
figure.autolayout      : True
figure.dpi             : 120

axes.facecolor         : 2B2F33
axes.edgecolor         : 3A4450
axes.labelcolor        : E6E9ED
axes.titlecolor        : E6E9ED
axes.linewidth         : 1.2
axes.spines.top        : False
axes.spines.right      : False

# Bright chart accents: Ion Blue, Neon Mint, Electric Emerald,
# Brass, Ion Blue Light, Soft Mint, Gridiron Violet, Edge Pink
axes.prop_cycle : cycler('color', ['1EA7FF','5FF2D2','00C853','6A37C8','D4B56E'])

axes.grid              : False
grid.color             : 3A4450
grid.linestyle         : --
grid.linewidth         : 0.7
grid.alpha             : 0.35

xtick.color            : E6E9ED
ytick.color            : E6E9ED
xtick.direction        : out
ytick.direction        : out
xtick.major.size       : 4
ytick.major.size       : 4
xtick.major.width      : 1
ytick.major.width      : 1

lines.linewidth        : 2.0
lines.markersize       : 5
lines.solid_capstyle   : round
lines.solid_joinstyle  : round

font.family            : sans-serif
font.sans-serif        : DejaVu Sans
font.size              : 11

axes.titlesize         : 14
axes.labelsize         : 12
xtick.labelsize        : 10
ytick.labelsize        : 10
legend.fontsize        : 10

legend.facecolor       : None   
legend.edgecolor       : 3A4450
legend.framealpha      : 0.9
legend.fancybox        : True
legend.borderpad       : 0.6
legend.labelcolor      : E6E9ED

savefig.facecolor      : 11214F
savefig.edgecolor      : 11214F
savefig.bbox           : tight
savefig.pad_inches     : 0.1

# Highlight (manual): Edge Pink FF5FA2
