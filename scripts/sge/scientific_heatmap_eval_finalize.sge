#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -q long
#$ -pe smp 1
#$ -l h_rt=08:00:00

set -euo pipefail
: "${REPO_ROOT:?REPO_ROOT is required}"
: "${HEATMAP_ROOT:?HEATMAP_ROOT is required}"
: "${COMPRESSION_ROOT:?COMPRESSION_ROOT is required}"
CONDA_ENV="${CONDA_ENV:-gridiron}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/tdnet-matplotlib-${USER}"
cd "${REPO_ROOT}"
python -m gridiron_ml.cli.publication.finalize_scientific_heatmap_eval \
  --manifest "${HEATMAP_ROOT}/job_manifest.parquet" \
  --output-root "${HEATMAP_ROOT}" \
  --compression-results "${COMPRESSION_ROOT}/summary/sequential_selected_results.parquet" \
  --require-compression
