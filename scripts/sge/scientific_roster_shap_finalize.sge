#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -q long
#$ -pe smp 1
#$ -l h_rt=02:00:00

set -euo pipefail
: "${REPO_ROOT:?REPO_ROOT is required}"
: "${SHAP_CONFIG:?SHAP_CONFIG is required}"
: "${SHAP_OUTPUT_ROOT:?SHAP_OUTPUT_ROOT is required}"
CONDA_ENV="${CONDA_ENV:-gridiron}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/tdnet-matplotlib-${USER}"
cd "${REPO_ROOT}"
python -m gridiron_ml.cli.publication.run_scientific_roster_shap finalize \
  --config "${SHAP_CONFIG}" --output-root "${SHAP_OUTPUT_ROOT}"
