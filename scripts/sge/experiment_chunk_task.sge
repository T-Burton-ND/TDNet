#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -q long
#$ -pe smp 1
#$ -l h_rt=08:00:00
#$ -o docs/logs/sge/$JOB_NAME.$JOB_ID.$TASK_ID.out

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT is required}"
: "${JOB_MANIFEST:?JOB_MANIFEST is required}"
CONDA_ENV="${CONDA_ENV:-gridiron}"

if command -v conda >/dev/null 2>&1 && conda env list | awk '{print $1}' | grep -qx "${CONDA_ENV}"; then
  eval "$(conda shell.bash hook)"
  conda activate "${CONDA_ENV}"
else
  echo "Conda environment '${CONDA_ENV}' not found; using the inherited Python." >&2
fi
if [[ -z "${PYTHON_BIN:-}" ]]; then
  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python)"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  elif [[ -x /afs/crc.nd.edu/x86_64_linux/c/conda/24.7.1/bin/python ]]; then
    PYTHON_BIN="/afs/crc.nd.edu/x86_64_linux/c/conda/24.7.1/bin/python"
  else
    echo "No usable Python executable found; set PYTHON_BIN." >&2
    exit 127
  fi
fi
echo "Using Python: ${PYTHON_BIN}"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/tdnet-matplotlib-${USER}"

cd "${REPO_ROOT}"
mkdir -p docs/logs/sge "${MPLCONFIGDIR}"

FORCE_ARGS=()
if [[ "${FORCE_RERUN:-0}" == "1" ]]; then
  FORCE_ARGS+=(--force)
fi
RETRY_ARGS=()
if [[ "${RETRY_INCOMPLETE:-0}" == "1" ]]; then
  RETRY_ARGS+=(--retry-incomplete)
fi

"${PYTHON_BIN}" src/gridiron_ml/cli/experiments/run_experiment_chunk.py \
  --job-manifest "${JOB_MANIFEST}" \
  --sge-task-id "${SGE_TASK_ID}" \
  --workers 1 \
  "${FORCE_ARGS[@]}" \
  "${RETRY_ARGS[@]}"
