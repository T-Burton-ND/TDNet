#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -q long
#$ -pe smp 1
#$ -l h_rt=08:00:00
set -euo pipefail
: "${REPO_ROOT:?}"; : "${MANIFEST:?}"; : "${FINGERPRINT_DATA:?}"; : "${ROSTER_OUTPUT_ROOT:?}"; : "${TRAIN_END_SEASON:?}"
eval "$(conda shell.bash hook)"; conda activate "${CONDA_ENV:-gridiron}"
export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
cd "${REPO_ROOT}"
python -m gridiron_ml.cli.publication.refit_corrected_f6_wide_roster finalize \
  --manifest "${MANIFEST}" --data "${FINGERPRINT_DATA}" --output-root "${ROSTER_OUTPUT_ROOT}" \
  --train-end-season "${TRAIN_END_SEASON}"
