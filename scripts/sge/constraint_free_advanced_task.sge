#!/usr/bin/env bash
#$ -cwd
#$ -j y
#$ -q long
#$ -pe smp 1
#$ -l h_rt=48:00:00
#$ -l h_vmem=16G
set -euo pipefail
: "${REPO_ROOT:?}"
: "${SEARCH_MANIFEST:?}"
: "${SGE_TASK_ID:?}"
export PYTHONPATH="${REPO_ROOT}/src:${REPO_ROOT}/scripts"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${TMPDIR:-/tmp}/tdnet-mpl-advanced-${SGE_TASK_ID}"
cd "${REPO_ROOT}"
exec /users/tburton2/.conda/envs/gridiron/bin/python scripts/constraint_free_advanced_search.py run \
  --manifest "${SEARCH_MANIFEST}" --task-id "${SGE_TASK_ID}"
