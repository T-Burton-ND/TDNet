#!/usr/bin/env bash
set -euo pipefail
: "${REPO_ROOT:?missing REPO_ROOT}"
: "${SEARCH_MANIFEST:?missing SEARCH_MANIFEST}"
: "${SGE_TASK_ID:?missing SGE_TASK_ID}"
export PYTHONPATH="$REPO_ROOT/src:$REPO_ROOT/scripts"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLCONFIGDIR="${TMPDIR:-/tmp}/tdnet-mpl-${SGE_TASK_ID}"
mkdir -p "$MPLCONFIGDIR"
cd "$REPO_ROOT"
exec /users/tburton2/.conda/envs/gridiron/bin/python \
  "$REPO_ROOT/scripts/constraint_free_extra_search.py" run \
  --manifest "$SEARCH_MANIFEST" --task-id "$SGE_TASK_ID"
