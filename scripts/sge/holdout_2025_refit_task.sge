set -euo pipefail
REPO_ROOT="${REPO_ROOT:-.}"
cd "${REPO_ROOT}"
export PYTHONPATH="${REPO_ROOT}/src:${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
python src/gridiron_ml/cli/experiments/run_2025_holdout_refit_task.py --manifest "${JOB_MANIFEST}" --sge-task-id "${SGE_TASK_ID}"
