{
  "version": 1,
  "format": "parquet",
  "grain": "one row per actual run plus summary rows per fingerprint architecture",
  "row_types": [
    "run",
    "fingerprint_architecture_summary"
  ],
  "required_columns": [
    "row_type",
    "run_id",
    "fingerprint_id",
    "generation",
    "lineage",
    "design",
    "ancestry",
    "feature_count",
    "feature_counts_by_generation_json",
    "model",
    "hyperparameter_setpoint",
    "seed",
    "status",
    "runtime_seconds",
    "train_metrics_json",
    "development_2024_metrics_json",
    "development_2025_metrics_json",
    "mae",
    "brier_score",
    "ats_accuracy",
    "chalk_accuracy",
    "upset_accuracy",
    "winner_accuracy",
    "feature_manifest_sha256",
    "correlation_summary_json",
    "shap_summary_ref",
    "missingness_summary_json",
    "coverage_summary_json",
    "failure_reason",
    "mae_2024",
    "mae_2025",
    "rmse_2024",
    "rmse_2025",
    "brier_2024",
    "brier_2025",
    "winner_accuracy_2024",
    "winner_accuracy_2025",
    "ats_accuracy_2024",
    "ats_accuracy_2025",
    "chalk_accuracy_2024",
    "chalk_accuracy_2025",
    "upset_accuracy_2024",
    "upset_accuracy_2025",
    "recommendation_eligible",
    "recommendation_selected",
    "recommendation_tie_band_mae",
    "recommendation_basis",
    "recommendation_rank",
    "prospective_boundary_year",
    "max_design_year_used",
    "acquisition_manifest_sha256",
    "acquisition_summary_ref",
    "source_schema_version"
  ],
  "status_values": [
    "success",
    "failed",
    "incomplete",
    "skipped"
  ],
  "large_model_artifacts": "discard_after_compact_diagnostics_extracted",
  "market_metrics": "evaluation_sidecar_only",
  "required_run_rows": "all 10 setpoints, including failed/incomplete, for each fingerprint and screening architecture",
  "acquisition_provenance": {
    "manifest": "results/preflight/cfbd_request_manifest_v1.jsonl",
    "summary": "results/preflight/cfbd_plan_summary_v1.json",
    "request_ledger": "request_ledger/",
    "include_in_final_result": true
  },
  "metric_interpretation": {
    "2024": "design_informed_internal_validation",
    "2025": "late_development_design_informed",
    "2026": "prospective_untouched_until_freeze"
  }
}
